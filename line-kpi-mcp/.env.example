SMLLINECRM_API_URL=http://localhost:3001
SMLLINECRM_API_KEY=your-api-key-here
# Layer 1 worker
MIN_IDLE_MINUTES=2
# Check every 30 minutes
POLL_INTERVAL_SEC=1800
# true = only urgent (customer waiting > 15 min) conversations
URGENT_ONLY=true
# true = send conversations no rule decided to the Layer 2 triage queue
ENQUEUE_LAYER2=true
# MCP server: true = expose read-only tools only (no propose / queue writes)
MCP_READ_ONLY=false
