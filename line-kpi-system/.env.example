# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/line_kpi

# API Security (for management endpoints)
API_KEY=change-me-to-a-strong-random-key

# Conversation threading
CONVERSATION_GAP_HOURS=4

# Timezone for date bucketing (affects daily summary grouping)
TZ=Asia/Bangkok

# AI Provider: "openrouter" or "kilo"
AI_PROVIDER=openrouter

# OpenRouter settings
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kilo settings (alternative)
KILO_API_KEY=
KILO_MODEL=
KILO_BASE_URL=

# Cron schedules (cron syntax, TZ applied)
# Close stale conversations before AI job runs
CRON_CLOSE_CONVERSATIONS=0 22 * * *
# Run AI evaluation
CRON_DAILY_EVALUATION=0 23 * * *

# Optional: evaluate previous day instead of same day (production default)
# EVALUATE_PREVIOUS_DAY=true
